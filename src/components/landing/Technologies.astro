---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const columns = [
  { key: "frontend", title: "Frontend", emptyText: "Añade una tecnología." },
  { key: "backend", title: "Backend", emptyText: "Añade una tecnología." },
  { key: "databases", title: "Databases", emptyText: "Añade una tecnología." },
  { key: "tools", title: "Herramientas", emptyText: "Añade una herramienta." },
];
---

<section class="scroll-mt-32" id="technologies">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug tracking-tighter lg:col-start-2 lg:col-span-2 text-base-900 dark:text-white"
        data-editable="sections.technologies.title"
      >
        {getContent("sections.technologies.title", "Tecnologías")}
      </Text>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-4">
      {
        columns.map((column) => (
          <article class="border-t border-base-200 py-6 dark:border-base-800">
            <Text
              tag="h3"
              variant="textLG"
              class="font-semibold text-base-900 dark:text-white"
              data-editable={`technologies.${column.key}.title`}
            >
              {getContent(`technologies.${column.key}.title`, column.title)}
            </Text>
            <ul
              class="mt-4 list-disc space-y-2 pl-5 text-sm text-base-600 dark:text-base-300"
              data-editable={`technologies.${column.key}.content`}
              data-editable-list
            >
              {
                getContent(
                  `technologies.${column.key}.content`,
                  column.emptyText,
                )
                  .split(/\r?\n/)
                  .map((item) => item.trim())
                  .filter(Boolean)
                  .map((item) => <li>{item}</li>)
              }
            </ul>
          </article>
        ))
      }
    </div>
  </Wrapper>
</section>