---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const introDefault =
  "Desarrollador en Argentina. Escribe aquí una breve presentación sobre ti, tu trabajo y lo que construyes.";
---

<section>
  <Wrapper variant="standard" class="pb-8 pt-40 lg:pt-80">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start gap-y-8">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white lg:col-start-3"
        data-editable="intro.text"
      >
        {getContent("intro.text", introDefault)}
      </Text>
      <Text
        tag="h3"
        variant="textLG"
        class="mt-6 text-left text-base-600 dark:text-base-300 lg:col-span-2 lg:col-start-3"
        data-editable="intro.subtitle"
      >
        {getContent("intro.subtitle", "Añade aquí un subtítulo.")}
      </Text>
      <Text
        tag="h3"
        variant="textLG"
        class="mt-6 text-left text-base-600 dark:text-base-300 lg:col-span-2 lg:col-start-3"
        data-editable="intro.subtitleTwo"
      >
        {getContent("intro.subtitleTwo", "Añade aquí un subtítulo.")}
      </Text>
    </div>
  </Wrapper>
</section>
