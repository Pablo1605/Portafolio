---
import EditableLink from "@/components/global/EditableLink.astro";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const linkClass =
  "border border-base-300 px-4 py-2 text-xs text-base-700 transition-colors hover:border-base-500 hover:text-base-900 dark:border-base-700 dark:text-base-200 dark:hover:border-base-500 dark:hover:text-white";
---

<div class="mt-5 flex flex-wrap gap-3">
  <EditableLink
    linkKey={`projects.${slug}.app`}
    textKey={`projects.${slug}.app.label`}
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
  >
    Ver aplicación
  </EditableLink>
  <EditableLink
    linkKey={`projects.${slug}.github`}
    textKey={`projects.${slug}.github.label`}
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    class={linkClass}
  >
    Ver código en GitHub
  </EditableLink>
</div>