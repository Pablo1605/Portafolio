---
import { withBase } from "@/lib/site";

const faviconVersion = "2";
---

<link rel="icon" href={`${withBase("icon.svg")}?v=${faviconVersion}`} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href={`${withBase("apple-touch-icon.png")}?v=${faviconVersion}`} />
<link rel="manifest" href={`${withBase("manifest.webmanifest")}?v=${faviconVersion}`} />
